# Copia este archivo a ".env" y rellena los valores.
# El archivo ".env" NUNCA debe subirse al repositorio (ya está en .gitignore).

# IDs de chat de Telegram permitidas para usar el bot (separadas por comas)
ALLOWED_CHAT_IDS=idchat,idchat

# IDs de chat de Telegram con permisos de administrador (separadas por comas)
ADMIN_CHAT_IDS=idchat,idchat

# Token del bot de Telegram, obtenido de BotFather
TELEGRAM_BOT_TOKEN=Telegram bot token

# IDs de usuario de Hack The Box a seguir (separados por comas)
HTB_USER_IDS=idnumer,idnumer,idnumer

# Bearer Token de la API de Hack The Box
HTB_BEARER_TOKEN=BearerToken

# Enlace a la Wiki/Notion del equipo
WIKI_URL=Wiki_url

# Configuración del proxy (true/false)
PROXY_ENABLED=false
PROXY_URL=http://127.0.0.1:8080
